{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Device Control Center",
  "version": "1.0.0",
  "identifier": "com.tangxingyu.devicecontrolcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://*.opencecs.com wss://*.opencecs.com; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-src 'self' https://*.opencecs.com"
    },
    "windows": [
      {
        "title": "Device Control Center",
        "width": 1440,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "externalBin": [
      "../../../backend/api/bin/device-control-backend"
    ],
    "resources": {
      "../../../backend/api/config/desktop_rules.json": "config/desktop_rules.json"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "c75f4f4e-2631-5021-bf27-efc3565c735c"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://127.0.0.1:8787/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NDc5RDlFRjUzRjY0RQpSV1JPOWxQdjJYbUVEM2UyTWtYWEhmUktCNzdOWnUwZnlTZ2k0ZEhnaWZrWXJZT2RBNmJTQmFlYwo="
    }
  }
}
